{
  "name": "wowadder",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:msi": "tauri build",
    "sync-version": "bun run scripts/sync-version.js",
    "release": "bun scripts/release.ts --no-changelog",
    "release:changelog": "bun scripts/release.ts",
    "tags:push": "git push origin main --tags",
    "patch:push": "bun run release patch && bun run tags:push",
    "minor:push": "bun run release minor && bun run tags:push",
    "major:push": "bun run release major && bun run tags:push",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "prettier": {
    "printWidth": 125,
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "tabWidth": 2,
    "bracketSpacing": true,
    "experimentalTernaries": true,
    "arrowParens": "always",
    "objectWrap": "preserve",
    "bracketSameLine": false,
    "htmlWhitespaceSensitivity": "strict",
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "curseforge-v2": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
