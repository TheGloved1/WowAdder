{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WowAdder",
  "version": "26.7.0",
  "identifier": "com.gloves.wowadder",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WowAdder",
        "width": 1200,
        "height": 800,
        "scrollBarStyle": "fluentOverlay",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      },
      "deb": {
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "homepage": "https://gloved.dev/wowadder",
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "rpm",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TheGloved1/WowAdder/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBNTQ5RDc0RERFNTJERjgKUldUNExlWGRkSjFVaXREZWpVeWo4ckowbHVpRjBpTmd2Y3pTMFhFVVBZekdBN2lvdnZqb2lGMlQK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "curseforge"
        ]
      }
    }
  }
}
